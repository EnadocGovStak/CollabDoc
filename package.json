{
  "name": "collabdoc",
  "version": "1.0.0",
  "description": "Collaborative Document Platform",
  "main": "index.js",
  "scripts": {
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "build": "cd frontend && npm run build && cd ../backend && mkdir -p public && cp -r ../frontend/build/* public/",
    "start": "cd backend && npm start",
    "docker:local": "docker compose -f docker-compose.local.yml up --build",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "smoke:browser": "playwright test tests/smoke/collabdoc.browser-smoke.spec.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^8.2.0"
  }
}
